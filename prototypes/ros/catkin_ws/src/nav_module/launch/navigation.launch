<launch>
  <!-- Load costmap configurations -->
  <rosparam file="$(find nav_module)/config/costmap_common.yaml" command="load" />
  <rosparam file="$(find nav_module)/config/global_costmap.yaml" command="load" />
  <rosparam file="$(find nav_module)/config/local_costmap.yaml" command="load" />

  <!-- AMCL Localization -->
  <node pkg="amcl" type="amcl" name="amcl">
    <param name="odom_frame_id" value="odom"/>
    <param name="base_frame_id" value="base_link"/>
    <rosparam file="$(find nav_module)/config/amcl.yaml" command="load" />
  </node>

  <!-- Move Base Navigation -->
  <node pkg="move_base" type="move_base" name="move_base" output="screen">
    <rosparam file="$(find nav_module)/config/move_base.yaml" command="load"/>
  </node>
</launch>
